[Unit]
Description=Linux DevOps Homework Service
After=network.target

[Service]
Type=simple
User=homework
Group=homework
ExecStart=/opt/linux-devops-homework/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/homework-app.service.d/override.conf
[Service]
ExecStart=
ExecStart=/usr/bin/python3 /opt/linux-devops-homework/app/server.py
